SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
# Keep this server-only key in backend/.env. Never expose it to the frontend.
SUPABASE_SERVICE_ROLE_KEY= 
# Optional integrations used by Zuri:
GROQ_API_KEY=
# Optional backup AI used automatically when Groq is rate limited or down. Any OpenAI-compatible provider works.
# Defaults to Google Gemini; for OpenAI use FALLBACK_AI_BASE_URL=https://api.openai.com/v1 and FALLBACK_AI_MODEL=gpt-4o-mini.
# Note: requests are then sent to that provider, so only enable one you are happy to share user prompts with.
FALLBACK_AI_API_KEY=
FALLBACK_AI_BASE_URL=
FALLBACK_AI_MODEL=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Required for linking user broker accounts. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing this key makes stored broker credentials unreadable.
BROKER_ENCRYPTION_KEY=

# Set true for the Alpaca paper-only release. Existing unsupported accounts can
# still be disconnected, but cannot be used for trading.
ZURI_PAPER_ONLY=false

# Optional. Enables the internal paper-fill reconciliation endpoint when set to
# a randomly generated secret of at least 32 bytes. Keep it server-only.
ALPACA_FILL_RECONCILIATION_SECRET=

# Leave false until the fill migration, scheduler, and reconciliation monitoring
# are installed and verified. Only Alpaca paper uses the confirmed-fill path.
ALPACA_CONFIRMED_FILL_JOURNAL=false
