SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
# Keep this server-only key in backend/.env. Never expose it to the frontend.
SUPABASE_SERVICE_ROLE_KEY= 
# Optional integrations used by Zuri:
GROQ_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Required for linking user broker accounts. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing this key makes stored broker credentials unreadable.
BROKER_ENCRYPTION_KEY=
